# ===== SERVER =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== JWT =====
JWT_SECRET=replace_this_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ===== DATABASE =====
DB_PATH=./data/voltra.db

# ===== ADMIN (seeded on first run) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== MONNIFY (online payments: card, bank transfer, USSD) =====
# Monnify dashboard -> Developer -> API Keys & Contracts. Keep the secret key private!
# MONNIFY_ENV: sandbox while testing, then change to live
MONNIFY_ENV=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# ===== EMAIL (SMTP - e.g. Gmail App Password, Zoho, Mailtrap for testing) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Volta Technologies NG <no-reply@voltra.ng>"

# ===== GOOGLE OAUTH (Continue with Google) =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== WHATSAPP =====
WHATSAPP_NUMBER=2348012345678

# ===== REFERRAL =====
REFERRAL_BONUS=500

# ===== VTPASS (real data / airtime / cable / electricity delivery) =====
# Get these from vtpass.com -> Profile -> API Keys (live) or sandbox.vtpass.com (testing).
# Set API AUTHENTICATION TYPE to "all" or "API keys" on that page. Keep the secret key private!
# VTPASS_ENV: use sandbox while testing, then change to live
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Optional: only set this if VTpass tells you to use a different API address
# VTPASS_BASE_URL=https://vtpass.com/api

# ===== YOUR PROFIT / LIMITS =====
# DATA_MARKUP_PERCENT = percent you add on top of VTpass data prices (rounded up to nearest 5 naira)
DATA_MARKUP_PERCENT=5
# CABLE_MARKUP = flat naira you add on top of each cable plan
CABLE_MARKUP=0
AIRTIME_MIN=50
AIRTIME_MAX=50000
ELECTRICITY_MIN=500
ELECTRICITY_MAX=100000
